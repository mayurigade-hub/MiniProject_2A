# EduVision — Environment Variables
# Copy this file to .env and fill in your values

# Groq API keys — use replacement keys after revoking any exposed keys.
# Comma-separated; requests rotate through this pool and retry another key on 429.
GROQ_API_KEYS=your_first_key,your_second_key
# Optional legacy single-key fallback when GROQ_API_KEYS is unset
# GROQ_API_KEY=your_groq_api_key_here

# Maximum uploaded lecture size in bytes (default: 2 GiB)
MAX_UPLOAD_BYTES=2147483648
